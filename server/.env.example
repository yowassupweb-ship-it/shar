# Шар API. Обязательны только база и SHAR_SECRET_KEY; остальное — по умолчанию.

# --- сервис ---
# SHAR_V2_HOST=127.0.0.1
# SHAR_V2_PORT=8100
# CORS_ORIGINS=            # через запятую; пусто — только тот же origin
# SHAR_COOKIE_SECURE=1     # 0 только для loopback HTTP-preview

# --- база (старая Postgres-база Шара) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shar_messenger
DB_USER=postgres
DB_PASSWORD=
# DB_STATEMENT_TIMEOUT_MS=30000
# SHAR_AUTO_MIGRATE=1      # применять migrations/*.sql при старте

# --- Redis: сессии, присутствие, rate limit, события ---
# REDIS_URL=redis://127.0.0.1:6379/0
# SHAR_SESSION_TTL=7776000
# SHAR_SESSION_CACHE_TTL=15

# --- секреты ---
# Ключ шифрования паролей почтовых ящиков (enc1:). Любая длинная строка. НЕ терять.
SHAR_SECRET_KEY=
# Внешний API уведомлений (docs/INTEGRATION_API.md): заголовок X-Shar-Integration-Key
SHAR_INTEGRATION_API_KEY=
# Server-to-server вызовы /api/push/notify
SHAR_INTERNAL_PUSH_KEY=

# --- web-push (VAPID) ---
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:admin@example.com

# --- файлы ---
# SHAR_DATA_DIR=./data
# SHAR_UPLOADS_DIR=./data/uploads
# SHAR_MAX_UPLOAD_BYTES=209715200
# S3 (необязательно): см. app/core/s3.py

# --- админка → «Сервер» ---
# Сервисы, статус которых показываем
# SHAR_SERVICES=shar-server,nginx,redis-server,postgresql
# SHAR_APP_DIR=/opt/shar
# Кнопки обслуживания: имя → argv. Только то, что перечислено здесь.
# SHAR_ADMIN_ACTIONS={"restart":["sudo","systemctl","restart","shar-server"]}

# --- прочее ---
# SHAR_MAIL_WATCH=1        # IMAP IDLE-слежение за ящиками
# SHAR_STARTUP_MAINTENANCE=1 # разовые совместимость/импорт при старте
# SHAR_SCHEDULED_JOBS=1    # напоминания; выключить на blue/green standby
# SHAR_LEGACY_DATA_DIR=    # разовый импорт data/*.json старого Next
# SHAR_SLOW_REQUEST_SECONDS=3
