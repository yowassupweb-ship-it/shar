# Copy to /etc/shar-next/api.env on the server and chmod 600 it.
# Never commit the real values.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=shar_messenger
DB_USER=postgres
DB_PASSWORD=
DB_STATEMENT_TIMEOUT_MS=30000

# Must point to the same Redis as the old application during blue/green rollout,
# otherwise existing Electron/web sessions will be lost after the switch.
REDIS_URL=redis://127.0.0.1:6379/0

SHAR_SECRET_KEY=
SHAR_INTEGRATION_API_KEY=
SHAR_INTERNAL_PUSH_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

SHAR_ENFORCE_AUTH=1
SHAR_LEGACY_ADOPT=0
CORS_ORIGINS=
